FROM node:22-bookworm-slim AS cli
RUN apt-get update && apt-get install --no-install-recommends -y curl ca-certificates \
    && npm install --global @larksuite/cli@1.0.48

FROM python:3.13-slim-bookworm
COPY --from=cli /usr/local/bin/node /usr/local/bin/node
COPY --from=cli /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN ln -s /usr/local/lib/node_modules/@larksuite/cli/scripts/run.js /usr/local/bin/lark-cli \
    && groupadd --gid 1001 archive \
    && useradd --uid 1001 --gid 1001 --home-dir /home/archive --create-home archive \
    && mkdir /data && chown 1001:1001 /data
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/home/archive \
    LARKSUITE_CLI_NO_UPDATE_NOTIFIER=1 LARKSUITE_CLI_NO_SKILLS_NOTIFIER=1
WORKDIR /app
COPY knowledge/ ./knowledge/
USER 1001:1001
CMD ["python", "-m", "knowledge.server", "--host", "0.0.0.0", "--port", "8797", "--config", "/run/archive/config.json", "--data-dir", "/data"]
