FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --gid 10001 paperplane && useradd --uid 10001 --gid 10001 --no-create-home paperplane
COPY private_update_server.py release_protocol.py ./
USER 10001:10001
EXPOSE 8080
CMD ["python", "private_update_server.py", "--data-dir", "/releases"]
